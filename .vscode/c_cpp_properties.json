{
    "configurations": [
        {
            "name": "ESP-IDF",
            "compilerPath": "/opt/esp/tools/riscv32-esp-elf/esp-14.2.0_20241119/riscv32-esp-elf/bin/riscv32-esp-elf-gcc",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "intelliSenseMode": "${default}",
            "cStandard": "gnu17",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/esp/idf/components/**",
                "${workspaceFolder}/managed_components/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
