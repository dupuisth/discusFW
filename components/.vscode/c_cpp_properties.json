{
    "configurations": [
        {
            "name": "ESP-IDF applications",
            "compileCommands": [
                "${workspaceFolder}/../applications/ambilight/build/compile_commands.json",
                "${workspaceFolder}/../applications/hello_world/build/compile_commands.json"
            ],
            "intelliSenseMode": "${default}",
            "cStandard": "gnu17",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/esp/idf/components/**",
                "${workspaceFolder}/../applications/**/managed_components/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/../applications",
                    "/opt/esp/idf/components"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4,
    "enableConfigurationSquiggles": true
}