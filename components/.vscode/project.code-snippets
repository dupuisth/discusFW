{
	"Section comment": {
		"prefix": "sec",
		"description": "Large comment to separate sections",
		"body": [
			"///////////////////////////////////////////",
			"// ${1:Title}",
			"///////////////////////////////////////////",
		]
	},
	"Section comment end": {
		"prefix": "sece",
		"description": "Large comment to separate sections",
		"body": [
			"//---------------------------------------//",
			"${1}"
		],
	},
	"Header template": {
		"prefix": "header",
		"description": "Header file template",
		"body": [
			"#ifndef ${1:Name}",
			"#define ${1:Name}",
			"${2}",
			"#endif // ${1:Name}"
		]
	}
}