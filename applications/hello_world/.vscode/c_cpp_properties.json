{
  "configurations": [
    {
      "name": "ESP-IDF",
      "compileCommands": [
        "${workspaceFolder}/build/compile_commands.json"
      ],
      "intelliSenseMode": "${default}",
      "cStandard": "gnu17",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/../../components/**",
        "${workspaceFolder}/managed_components/**",
        "/opt/esp/idf/components/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/../../components",
          "${workspaceFolder}/managed_components",
          "/opt/esp/idf/components"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "compilerPath": "/opt/esp/tools/riscv32-esp-elf/esp-14.2.0_20260121/riscv32-esp-elf/bin/riscv32-esp-elf-gcc"
    }
  ],
  "version": 4,
  "enableConfigurationSquiggles": true
}
